{
  "name": "queryn-docs",
  "version": "0.1.0",
  "description": "Product and architecture documentation for Queryn.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vitepress dev docs",
    "verify": "node ../queryn-spec/scripts/check-documentation.mjs --only D1,D2,D3,D4,D5,D7",
    "diagram:check": "node ../queryn-spec/scripts/check-documentation.mjs --only D4",
    "build": "pnpm verify && vitepress build docs",
    "preview": "vitepress preview docs"
  },
  "keywords": [
    "queryn",
    "documentation",
    "vitepress"
  ],
  "author": "Queryn Labs",
  "license": "CC-BY-4.0",
  "packageManager": "pnpm@10.5.2",
  "devDependencies": {
    "mermaid": "^11.17.2",
    "vue": "^3.5.13",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
